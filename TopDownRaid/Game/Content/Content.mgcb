#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin Shaders/Deferred.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:Shaders/Deferred.fx

# ---------------------------------------------------------------------------
# Optional real art. The game generates all textures procedurally, but if these
# entries are un-commented (and the PNGs exist under Content/Textures) then
# Game1.LoadOrGenerate() will load them instead of the procedural versions.
# Normal maps MUST be built with ColorKeyEnabled=False and PremultiplyAlpha=False
# so the encoded XYZ channels are not altered by the pipeline.
# ---------------------------------------------------------------------------
